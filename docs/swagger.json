{
    "swagger": "2.0",
    "info": {
        "description": "Slicer API\n基于Kubernetes资源的切片管理系统API\n包括 切片管理 监控管理 性能保证 等功能",
        "title": "Slicer API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:30001",
    "basePath": "/",
    "paths": {
        "/controller": {
            "get": {
                "description": "返回控制器运行状态、策略列表及当前生效策略",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Controller"
                ],
                "summary": "获取控制器状态",
                "responses": {
                    "200": {
                        "description": "成功获取控制器状态",
                        "schema": {
                            "$ref": "#/definitions/api.ControllerResponse"
                        }
                    },
                    "500": {
                        "description": "响应编码失败",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "动态更新运行状态、控制频率或切换调度策略",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Controller"
                ],
                "summary": "更新控制器配置",
                "parameters": [
                    {
                        "description": "更新配置参数",
                        "name": "config",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.UpdateControllerRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "配置更新成功"
                    },
                    "400": {
                        "description": "请求解析失败/策略不存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "内部配置更新失败",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/monitor": {
            "get": {
                "description": "获取系统中存在的所有监控配置列表",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitor"
                ],
                "summary": "获取所有监控配置",
                "responses": {
                    "200": {
                        "description": "获取成功",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.Monitor"
                            }
                        }
                    },
                    "500": {
                        "description": "获取数据失败",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "创建监控请求并部署到Kubernetes集群，包含MDE和KPI组件",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitor"
                ],
                "summary": "创建监控资源（内置部署）",
                "parameters": [
                    {
                        "description": "监控配置对象",
                        "name": "monitor",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.Monitor"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "创建成功返回监控对象",
                        "schema": {
                            "$ref": "#/definitions/model.Monitor"
                        }
                    },
                    "400": {
                        "description": "请求解码失败/参数验证失败",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "关联的 Slice 不存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "创建失败（YAML渲染/部署/存储）",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/monitor/external": {
            "post": {
                "description": "通过Monarch外部服务提交监控请求\n实际Monarch没有做任何处理, 这里将直接开启全部切片的监控, 仅用于测试",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitor"
                ],
                "summary": "创建监控资源（外部服务）",
                "parameters": [
                    {
                        "description": "监控配置对象",
                        "name": "monitor",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.Monitor"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "监控创建成功, 注意没有返回值"
                    },
                    "400": {
                        "description": "请求解码失败/参数验证失败/Slice不存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "提交外部请求失败/存储失败",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/monitor/external/{monitor_id}": {
            "delete": {
                "description": "通过Monarch外部服务删除监控请求\n实际Monarch没有做任何处理, 这里将删除createMonitorExternal创建的的监控, 仅用于测试",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitor"
                ],
                "summary": "删除监控资源（外部服务）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "监控记录ID",
                        "name": "monitorID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "外部服务请求ID",
                        "name": "requestId",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功"
                    },
                    "400": {
                        "description": "缺少参数/格式错误",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "监控记录不存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "外部请求失败/存储删除失败",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/monitor/supported_kpis": {
            "get": {
                "description": "返回系统支持的所有KPI指标定义",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitor"
                ],
                "summary": "获取支持监控的KPI列表",
                "responses": {
                    "200": {
                        "description": "成功获取KPI列表",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.SupportedKpi"
                            }
                        }
                    },
                    "500": {
                        "description": "服务器内部错误（获取失败）",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/monitor/{monitor_id}": {
            "get": {
                "description": "根据监控ID获取详细配置信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitor"
                ],
                "summary": "获取单个监控配置",
                "parameters": [
                    {
                        "type": "string",
                        "description": "监控记录ID",
                        "name": "monitorID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "获取成功",
                        "schema": {
                            "$ref": "#/definitions/model.Monitor"
                        }
                    },
                    "400": {
                        "description": "缺少监控ID参数",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "监控记录不存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "获取数据失败",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "根据ID删除监控资源并清理Kubernetes组件",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Monitor"
                ],
                "summary": "删除监控资源（内置部署）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "监控记录ID",
                        "name": "monitorID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "资源删除成功"
                    },
                    "400": {
                        "description": "缺少监控 ID 参数",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "监控记录不存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "删除失败（YAML 渲染/组件/存储）",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/nfv-orchestrator/api/health": {
            "get": {
                "description": "验证NFV编排组件的运行状态",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NFV Orchestrator"
                ],
                "summary": "NFV Orchestrator健康检查",
                "responses": {
                    "200": {
                        "description": "服务健康状态",
                        "schema": {
                            "$ref": "#/definitions/api.noCheckHealthResponse"
                        }
                    }
                }
            }
        },
        "/nfv-orchestrator/kpi-computation/check": {
            "post": {
                "description": "验证KPI计算引擎Pod的运行状态",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NFV Orchestrator"
                ],
                "summary": "检查KPI组件状态",
                "responses": {
                    "200": {
                        "description": "Pod状态列表",
                        "schema": {
                            "$ref": "#/definitions/api.noKpiComputationCheckResponse"
                        }
                    },
                    "500": {
                        "description": "Pod查询失败",
                        "schema": {
                            "$ref": "#/definitions/api.noKpiComputationCheckResponse"
                        }
                    }
                }
            }
        },
        "/nfv-orchestrator/kpi-computation/install": {
            "post": {
                "description": "部署实时KPI计算引擎到监控命名空间",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NFV Orchestrator"
                ],
                "summary": "安装KPI计算组件",
                "parameters": [
                    {
                        "description": "请求参数",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.noKpiComputationInstallRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "KPI组件安装成功",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "400": {
                        "description": "参数校验失败",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "500": {
                        "description": "YAML渲染/K8s部署失败",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    }
                }
            }
        },
        "/nfv-orchestrator/kpi-computation/uninstall": {
            "post": {
                "description": "移除KPI计算引擎相关资源",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NFV Orchestrator"
                ],
                "summary": "卸载KPI计算组件",
                "responses": {
                    "200": {
                        "description": "KPI组件卸载成功",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "500": {
                        "description": "YAML渲染/K8s删除失败",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    }
                }
            }
        },
        "/nfv-orchestrator/mde/check": {
            "post": {
                "description": "验证监控数据采集器的服务端点是否就绪",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NFV Orchestrator"
                ],
                "summary": "检查MDE运行状态",
                "responses": {
                    "200": {
                        "description": "MDE服务列表",
                        "schema": {
                            "$ref": "#/definitions/api.noMdeCheckResponse"
                        }
                    },
                    "500": {
                        "description": "服务查询失败",
                        "schema": {
                            "$ref": "#/definitions/api.noMdeCheckResponse"
                        }
                    }
                }
            }
        },
        "/nfv-orchestrator/mde/install": {
            "post": {
                "description": "根据切片ID部署Prometheus exporter组件到指定命名空间",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NFV Orchestrator"
                ],
                "summary": "安装监控数据采集器（MDE）",
                "parameters": [
                    {
                        "description": "请求参数",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.noMdeInstallRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "MDE安装成功",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "400": {
                        "description": "请求参数不合法",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "404": {
                        "description": "切片不存在",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "500": {
                        "description": "渲染YAML失败/K8s部署失败",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    }
                }
            }
        },
        "/nfv-orchestrator/mde/uninstall": {
            "post": {
                "description": "移除当前命名空间下的Prometheus exporter组件",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "NFV Orchestrator"
                ],
                "summary": "卸载监控数据采集器（MDE）",
                "responses": {
                    "200": {
                        "description": "MDE卸载成功",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "500": {
                        "description": "YAML渲染失败/K8s删除失败",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    }
                }
            }
        },
        "/service-orchestrator/api/health": {
            "get": {
                "description": "验证Service Orchestrator组件运行状态",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Service Orchestrator"
                ],
                "summary": "服务健康检查",
                "responses": {
                    "200": {
                        "description": "服务正常运行",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    }
                }
            }
        },
        "/service-orchestrator/slices/{slice_id}": {
            "get": {
                "description": "查询指定切片下的NFV组件Pod详细信息（面向监控系统）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Service Orchestrator"
                ],
                "summary": "获取切片组件信息",
                "parameters": [
                    {
                        "type": "string",
                        "example": "edge01",
                        "description": "切片唯一标识符",
                        "name": "sliceID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.soGetSliceComponentsResponse"
                        }
                    },
                    "400": {
                        "description": "参数校验失败",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "404": {
                        "description": "切片不存在",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    },
                    "500": {
                        "description": "服务器内部错误",
                        "schema": {
                            "$ref": "#/definitions/monitor.Response"
                        }
                    }
                }
            }
        },
        "/slice": {
            "get": {
                "description": "获取当前系统中的所有切片列表",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Slice"
                ],
                "summary": "获取所有切片",
                "responses": {
                    "200": {
                        "description": "获取成功，返回切片列表",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.SliceProfile"
                            }
                        }
                    },
                    "500": {
                        "description": "服务器内部错误（获取列表失败、响应编码失败）",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "接受一个切片对象，更新指定的切片，并返回更新后的切片对象",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Slice"
                ],
                "summary": "更新切片",
                "parameters": [
                    {
                        "description": "切片对象，包含切片ID、KubeConfig和SLA等信息",
                        "name": "slice",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.SliceProfile"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "更新成功，返回更新后的切片对象",
                        "schema": {
                            "$ref": "#/definitions/model.SliceProfile"
                        }
                    },
                    "400": {
                        "description": "请求格式错误或参数非法",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "切片不存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "服务器内部错误（更新k8s资源失败、分配IP失败、存储更新失败）",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "接受一个切片对象，创建一个新的切片，并返回创建的切片对象",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Slice"
                ],
                "summary": "创建切片",
                "parameters": [
                    {
                        "description": "切片对象，包含切片ID、KubeConfig和SLA等信息",
                        "name": "slice",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.SliceProfile"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "创建成功，返回切片及其地址",
                        "schema": {
                            "$ref": "#/definitions/model.SliceProfile"
                        }
                    },
                    "400": {
                        "description": "请求格式错误或参数非法",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "切片已存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "服务器内部错误，如分配IP或部署资源失败",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/slice/{slice_id}": {
            "get": {
                "description": "根据切片ID获取指定切片的详细信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Slice"
                ],
                "summary": "获取单个切片",
                "parameters": [
                    {
                        "type": "string",
                        "description": "切片ID",
                        "name": "sliceID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "获取成功",
                        "schema": {
                            "$ref": "#/definitions/model.SliceProfile"
                        }
                    },
                    "400": {
                        "description": "缺少sliceID参数",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "切片不存在",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "服务器内部错误（获取失败、响应编码失败）",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "根据切片ID删除指定的切片资源",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Slice"
                ],
                "summary": "删除切片",
